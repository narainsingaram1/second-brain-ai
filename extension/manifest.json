{
  "manifest_version": 3,
  "name": "Synapse Browser Agent",
  "version": "1.0.0",
  "description": "Lets your Synapse assistant open sites and do things for you in Chrome, in its own tab group, with your go-ahead before anything is bought, sent or deleted.",
  "minimum_chrome_version": "116",
  "permissions": ["tabs", "tabGroups", "scripting", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_title": "Synapse Browser Agent", "default_popup": "popup.html" },
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*", "https://synapse-narain-brain.coolfiregoon.chatgpt.site/*", "https://second-brain-ai-src-tauri.vercel.app/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    }
  ]
}
